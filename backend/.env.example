# Copy to .env and fill in. Never commit .env.

# Fire API (the only paid service). Backend-only; never sent to the browser.
FIRE_API_KEY=
FIRE_BASE_URL=https://fire.prosaga.net
FIRE_MONTHLY_BUDGET_USD=1
# Chat model (see https://fire.prosaga.net/v1/capabilities); a low-cost one keeps us in budget.
FIRE_CHAT_MODEL=gpt-4o-mini
# Interviewer voice: "browser" (free, the browser's built-in speech) or "fire" (Fire
# /v1/speech, billed per turn). Optional Fire voice ids per persona / role-play character.
VOICE_PROVIDER=browser
# Speech model for VOICE_PROVIDER=fire; tts-kokoro is Fire's cheapest.
FIRE_SPEECH_MODEL=tts-kokoro
FIRE_VOICE_FRIENDLY=
FIRE_VOICE_NEUTRAL=
FIRE_VOICE_TOUGH=
FIRE_VOICE_CHARACTER=

# MySQL 8, e.g. mysql+pymysql://user:password@localhost:3306/mock_interviewer
DATABASE_URL=

# Long random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
