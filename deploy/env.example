# Copy to ./.env on the server (next to docker-compose.yml). Never commit it.

# Public hostname of the API (free DuckDNS subdomain); Caddy gets HTTPS for it.
API_DOMAIN=yourname.duckdns.org

# MySQL inside Docker (not exposed to the internet). Long random strings:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Flask (32+ random characters each; the app refuses to start otherwise).
SECRET_KEY=
JWT_SECRET_KEY=

# The Vercel URL of the frontend (comma-separate several).
CORS_ORIGINS=https://your-app.vercel.app

# Fire API: the only paid service. Stays on the server.
FIRE_API_KEY=
FIRE_BASE_URL=https://fire.prosaga.net
FIRE_MONTHLY_BUDGET_USD=1
FIRE_CHAT_MODEL=gpt-4o-mini
VOICE_PROVIDER=browser
FIRE_SPEECH_MODEL=tts-kokoro

# Who can open /admin (comma-separated emails).
ADMIN_EMAILS=
